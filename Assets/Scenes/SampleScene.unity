  m_Script: {fileID: 11500000, guid: fe1ca793c7863284a9d42f8e4f911792, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EducationalInteractable
  title: Unidad de Control
  subtitle: Coordinadora del procesador
  promptText: '[E] Examinar'
  progressionKey: UNIDAD_CONTROL
  proximityRadius: 10
  labelHeight: 2
  description: "La Unidad de Control coordina el funcionamiento de todo el procesador.\n\nCaracter\xEDsticas:\n-
    Interpreta las instrucciones\n- Genera las se\xF1ales de control\n- Coordina
    la ALU, los registros y la memoria durante cada ciclo"
  activityMode: 1
  activityTitle: "DIAGN\xD3STICO DE LA UNIDAD DE CONTROL"
  operandA: 15
  operandB: 7
  operation: 1
  conceptQuestion: "La CPU necesita ejecutar una instruccion.\n\n\xBFQue componente
    coordina lo que debe hacer?"
  conceptOptions:
  - ALU
  - UNIDAD DE CONTROL
  - RAM
  conceptCorrectIndex: 1
  rewardTitle: "\u2713 UNIDAD DE CONTROL COMPRENDIDA"
  rewardText: Has aprendido que la Unidad de Control coordina la ejecucion de instrucciones
    entre la ALU, los registros y la memoria.
  objectiveCompletedText: 'Objetivo completado: Unidad de Control comprendida.'
