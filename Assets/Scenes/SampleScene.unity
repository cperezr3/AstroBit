  m_Script: {fileID: 11500000, guid: fe1ca793c7863284a9d42f8e4f911792, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EducationalInteractable
  title: Cache L2
  subtitle: "Memoria Cach\xE9 de Nivel 2"
  promptText: '[E] Examinar'
  progressionKey: CACHE_L2
  proximityRadius: 10
  labelHeight: 2
  description: "La Cache L2 es m\xE1s grande que la L1 pero un poco m\xE1s lenta.\n\nCaracter\xEDsticas:\n-
    Mayor capacidad que L1\n- Sigue siendo mucho m\xE1s r\xE1pida que la RAM\n- Act\xFAa
    como respaldo cuando L1 no tiene el dato"
  activityMode: 1
  activityTitle: "DIAGN\xD3STICO DE CACHE L2"
  operandA: 14
  operandB: 6
  operation: 1
  conceptQuestion: "La Cache L1 no tiene el dato que la CPU necesita.\n\n\xBFQue
    nivel de cache, mas grande pero un poco mas lento, se consulta despues?"
  conceptOptions:
  - CACHE L2
  - RAM
  - CACHE L1
  conceptCorrectIndex: 0
  rewardTitle: "\u2713 CACHE L2 COMPRENDIDA"
  rewardText: Has aprendido que la Cache L2 tiene mas capacidad que la L1, a cambio
    de ser un poco mas lenta.
  objectiveCompletedText: 'Objetivo completado: Cache L2 comprendida.'
